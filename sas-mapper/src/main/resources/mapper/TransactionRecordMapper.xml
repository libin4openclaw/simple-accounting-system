<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.simple.accounting.mapper.TransactionRecordMapper">

    <resultMap id="BaseResultMap" type="com.simple.accounting.entity.TransactionRecord">
        <id column="id" property="id"/>
        <result column="trans_no" property="transNo"/>
        <result column="loan_no" property="loanNo"/>
        <result column="trans_type" property="transType"/>
        <result column="trans_date" property="transDate"/>
        <result column="trans_amount" property="transAmount"/>
        <result column="principal" property="principal"/>
        <result column="interest" property="interest"/>
        <result column="penalty" property="penalty"/>
        <result column="balance_before" property="balanceBefore"/>
        <result column="balance_after" property="balanceAfter"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectByTransNo" resultMap="BaseResultMap">
        SELECT * FROM transaction_record WHERE trans_no = #{transNo}
    </select>

    <select id="selectByLoanNo" resultMap="BaseResultMap">
        SELECT * FROM transaction_record WHERE loan_no = #{loanNo} ORDER BY create_time DESC
    </select>

    <select id="selectByLoanNoAndTransType" resultMap="BaseResultMap">
        SELECT * FROM transaction_record
        WHERE loan_no = #{loanNo} AND trans_type = #{transType}
        ORDER BY create_time DESC
    </select>

    <update id="updateTransStatus">
        UPDATE transaction_record
        SET trans_status = #{transStatus},
            update_time = NOW()
        WHERE trans_no = #{transNo}
    </update>

</mapper>
